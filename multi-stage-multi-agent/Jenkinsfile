pipeline {
  agent any

  stages {

    stage('Back-end') {
      steps {
        echo 'Starting Maven container...'
        sh 'docker run --name maven-container maven:3.8.1-adoptopenjdk-11 mvn --version'
        echo 'Maven container finished!'
      }
      
    }

    stage('Front-end') {
      steps {
        echo 'Starting Node container...'
        sh 'docker run --name node-container node:16-alpine node --version'
        echo 'Node container finished!'
      }
      
    }

  

  }

  post {
    success {
      echo 'Pipeline completed successfully!'
    }
    failure {
      echo 'Pipeline failed! Check logs.'
    }
    always {
      echo 'Pipeline done!'
    }
  }
}
